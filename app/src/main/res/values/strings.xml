    <!-- Setup (first start; done together with the guardian) -->
    <string name="setup_intro_title">Welcome</string>
    <string name="setup_intro_body">Lares blocks the apps and websites you choose. Adding restrictions is always possible – removing or loosening them needs a code that only a trusted person knows: your guardian, for example a friend or family member.\n\nFor the next steps, please hand the phone to your guardian.</string>
    <string name="setup_intro_start">Let’s start</string>
    <string name="setup_method_title">Guardian: choose your code</string>
    <string name="setup_method_body">The code is needed whenever restrictions are paused or loosened. Don’t tell it to the phone owner.</string>
    <string name="setup_method_password_title">Password</string>
    <string name="setup_method_password_desc">You set a password now and type it on this phone whenever it’s needed.</string>
    <string name="setup_method_totp_title">Authenticator app</string>
    <string name="setup_method_totp_desc">Codes from an app on your own phone (e.g. Aegis or FreeOTP). Each code works only once, so you can also send it by message.</string>
    <string name="setup_password_title">Set the password</string>
    <string name="setup_password_label">Password</string>
    <string name="setup_password_repeat_label">Repeat password</string>
    <plurals name="setup_password_too_short">
        <item quantity="one">Use at least %d character.</item>
        <item quantity="other">Use at least %d characters.</item>
    </plurals>
    <string name="setup_password_mismatch">The passwords don’t match.</string>
    <string name="setup_continue">Continue</string>
    <string name="setup_back">Back</string>
    <string name="setup_totp_title">Scan with your authenticator app</string>
    <string name="setup_totp_body">Open your authenticator app, add a new account and scan this code. Then enter the 6-digit code the app shows.</string>
    <string name="setup_totp_qr_description">QR code for the authenticator app</string>
    <string name="setup_totp_manual">Or enter this key manually:</string>
    <string name="setup_totp_code_label">6-digit code</string>
    <string name="setup_totp_wrong">That code doesn’t match. Check that the time is correct on both phones and enter the current code.</string>
    <string name="setup_totp_confirm">Confirm</string>
    <string name="setup_recovery_title">Recovery code</string>
    <string name="setup_recovery_body">If the code is ever lost, this recovery code unlocks Lares once. It is shown only now. Guardian: write it down or store it safely – don’t leave it with the phone owner.</string>
    <string name="setup_recovery_confirm">I have stored the recovery code safely</string>
    <string name="setup_finish">Done</string>

